/**settings.wxss**/

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 0;
}

.title {
  font-size: 20px;
  font-weight: bold;
  color: var(--text-color);
}

/* Vant 组件主题适配 */
.cell-dark {
  --cell-background-color: #2c2c2e !important;
  --cell-text-color: #f5f5f5 !important;
  --cell-border-color: #3a3a3c !important;
  --cell-active-color: #3a3a3c !important;
}

.cell-group-dark {
  --cell-group-title-color: #f5f5f5 !important;
  --cell-group-inset-padding: 16px !important;
  --cell-group-inset-border-radius: 8px !important;
  --cell-group-inset-title-padding: 16px !important;
}

/* 主题预览 */
.theme-preview {
  padding: 16px;
  margin-top: 16px;
}

.preview-title {
  font-size: 14px;
  color: var(--text-color);
  margin-bottom: 10px;
  padding-left: 16px;
}

.preview-card {
  background-color: #fff;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.preview-card-dark {
  background-color: #2c2c2e;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.preview-card-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
  color: var(--text-color);
}

.preview-card-content {
  font-size: 14px;
  color: var(--text-color);
  margin-bottom: 16px;
}

.preview-buttons {
  display: flex;
  flex-direction: row;
}

.preview-button {
  margin-right: 8px;
}