/**index.wxss**/

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 0;
}

.logo {
  width: 100px;
  height: 100px;
  margin-bottom: 10px;
}

.title {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 5px;
  color: var(--text-color);
}

.subtitle {
  font-size: 14px;
  color: var(--text-color);
  opacity: 0.8;
}

.content {
  padding-bottom: 20px;
  width: 100%;
  box-sizing: border-box;
}

.card {
  margin-top: 16px;
  transition: all 0.3s;
}

.card-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
  color: var(--text-color);
}

.card-content {
  font-size: 14px;
  color: var(--text-color);
  line-height: 1.6;
}

.demo-button {
  margin-right: 8px;
  margin-bottom: 8px;
}